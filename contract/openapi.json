{
  "components": {
    "schemas": {
      "ChatEvent": {
        "description": "Every SSE `data:` payload on the chat stream is one of these.",
        "discriminator": {
          "mapping": {
            "run_completed": "#/components/schemas/RunCompletedEvent",
            "run_failed": "#/components/schemas/RunFailedEvent",
            "run_started": "#/components/schemas/RunStartedEvent",
            "text_delta": "#/components/schemas/TextDeltaEvent",
            "thinking_delta": "#/components/schemas/ThinkingDeltaEvent",
            "tool_finished": "#/components/schemas/ToolFinishedEvent",
            "tool_started": "#/components/schemas/ToolStartedEvent",
            "usage_updated": "#/components/schemas/UsageUpdatedEvent"
          },
          "propertyName": "type"
        },
        "oneOf": [
          {
            "$ref": "#/components/schemas/RunStartedEvent"
          },
          {
            "$ref": "#/components/schemas/TextDeltaEvent"
          },
          {
            "$ref": "#/components/schemas/ThinkingDeltaEvent"
          },
          {
            "$ref": "#/components/schemas/UsageUpdatedEvent"
          },
          {
            "$ref": "#/components/schemas/RunCompletedEvent"
          },
          {
            "$ref": "#/components/schemas/RunFailedEvent"
          },
          {
            "$ref": "#/components/schemas/ToolStartedEvent"
          },
          {
            "$ref": "#/components/schemas/ToolFinishedEvent"
          }
        ],
        "title": "ChatEvent"
      },
      "ChatRunRequest": {
        "description": "Send one user message. Model and reasoning may change from message to message.",
        "properties": {
          "content": {
            "maxLength": 20000,
            "minLength": 1,
            "title": "Content",
            "type": "string"
          },
          "model": {
            "$ref": "#/components/schemas/ModelChoice",
            "default": "sonnet"
          },
          "reasoning": {
            "$ref": "#/components/schemas/ReasoningLevel",
            "default": "balanced"
          }
        },
        "required": [
          "content"
        ],
        "title": "ChatRunRequest",
        "type": "object"
      },
      "ConversationCreate": {
        "description": "Start an empty conversation. Its first message gives it a title.",
        "properties": {
          "model": {
            "$ref": "#/components/schemas/ModelChoice",
            "default": "sonnet"
          },
          "reasoning": {
            "$ref": "#/components/schemas/ReasoningLevel",
            "default": "balanced"
          }
        },
        "title": "ConversationCreate",
        "type": "object"
      },
      "ConversationDetail": {
        "properties": {
          "id": {
            "title": "Id",
            "type": "string"
          },
          "messages": {
            "items": {
              "$ref": "#/components/schemas/MessageRead"
            },
            "title": "Messages",
            "type": "array"
          },
          "model": {
            "$ref": "#/components/schemas/ModelChoice",
            "default": "sonnet"
          },
          "reasoning": {
            "$ref": "#/components/schemas/ReasoningLevel",
            "default": "balanced"
          },
          "title": {
            "title": "Title",
            "type": "string"
          },
          "updatedAt": {
            "format": "date-time",
            "title": "Updatedat",
            "type": "string"
          }
        },
        "required": [
          "model",
          "reasoning",
          "id",
          "title",
          "updatedAt",
          "messages"
        ],
        "title": "ConversationDetail",
        "type": "object"
      },
      "ConversationSummary": {
        "properties": {
          "id": {
            "title": "Id",
            "type": "string"
          },
          "model": {
            "$ref": "#/components/schemas/ModelChoice",
            "default": "sonnet"
          },
          "reasoning": {
            "$ref": "#/components/schemas/ReasoningLevel",
            "default": "balanced"
          },
          "title": {
            "title": "Title",
            "type": "string"
          },
          "updatedAt": {
            "format": "date-time",
            "title": "Updatedat",
            "type": "string"
          }
        },
        "required": [
          "model",
          "reasoning",
          "id",
          "title",
          "updatedAt"
        ],
        "title": "ConversationSummary",
        "type": "object"
      },
      "CurrentUserRead": {
        "properties": {
          "email": {
            "title": "Email",
            "type": "string"
          },
          "scopes": {
            "items": {
              "type": "string"
            },
            "title": "Scopes",
            "type": "array"
          }
        },
        "required": [
          "email",
          "scopes"
        ],
        "title": "CurrentUserRead",
        "type": "object"
      },
      "FieldError": {
        "properties": {
          "code": {
            "title": "Code",
            "type": "string"
          },
          "field": {
            "title": "Field",
            "type": "string"
          },
          "message": {
            "title": "Message",
            "type": "string"
          }
        },
        "required": [
          "field",
          "message",
          "code"
        ],
        "title": "FieldError",
        "type": "object"
      },
      "GoogleLoginRequest": {
        "properties": {
          "code": {
            "description": "One-time authorization code from Google",
            "minLength": 1,
            "title": "Code",
            "type": "string"
          }
        },
        "required": [
          "code"
        ],
        "title": "GoogleLoginRequest",
        "type": "object"
      },
      "HealthRead": {
        "properties": {
          "status": {
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "status"
        ],
        "title": "HealthRead",
        "type": "object"
      },
      "MessageRead": {
        "properties": {
          "content": {
            "title": "Content",
            "type": "string"
          },
          "createdAt": {
            "format": "date-time",
            "title": "Createdat",
            "type": "string"
          },
          "durationMs": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Durationms"
          },
          "id": {
            "title": "Id",
            "type": "string"
          },
          "parts": {
            "anyOf": [
              {
                "items": {
                  "discriminator": {
                    "mapping": {
                      "note": "#/components/schemas/TextPart",
                      "text": "#/components/schemas/TextPart",
                      "thinking": "#/components/schemas/TextPart",
                      "tool": "#/components/schemas/ToolPart"
                    },
                    "propertyName": "type"
                  },
                  "oneOf": [
                    {
                      "$ref": "#/components/schemas/TextPart"
                    },
                    {
                      "$ref": "#/components/schemas/ToolPart"
                    }
                  ]
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "title": "Parts"
          },
          "role": {
            "enum": [
              "user",
              "assistant"
            ],
            "title": "Role",
            "type": "string"
          },
          "usage": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/Usage"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "id",
          "role",
          "content",
          "parts",
          "durationMs",
          "usage",
          "createdAt"
        ],
        "title": "MessageRead",
        "type": "object"
      },
      "ModelChoice": {
        "enum": [
          "sonnet",
          "haiku"
        ],
        "title": "ModelChoice",
        "type": "string"
      },
      "ProblemDetail": {
        "properties": {
          "code": {
            "title": "Code",
            "type": "string"
          },
          "detail": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Detail"
          },
          "errors": {
            "anyOf": [
              {
                "items": {
                  "$ref": "#/components/schemas/FieldError"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "title": "Errors"
          },
          "instance": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Instance"
          },
          "status": {
            "title": "Status",
            "type": "integer"
          },
          "title": {
            "title": "Title",
            "type": "string"
          },
          "type": {
            "default": "about:blank",
            "title": "Type",
            "type": "string"
          }
        },
        "required": [
          "type",
          "title",
          "status",
          "code",
          "detail",
          "instance",
          "errors"
        ],
        "title": "ProblemDetail",
        "type": "object"
      },
      "ReasoningLevel": {
        "enum": [
          "fast",
          "balanced",
          "deep"
        ],
        "title": "ReasoningLevel",
        "type": "string"
      },
      "RunCompletedEvent": {
        "properties": {
          "durationMs": {
            "title": "Durationms",
            "type": "integer"
          },
          "messageId": {
            "title": "Messageid",
            "type": "string"
          },
          "type": {
            "const": "run_completed",
            "default": "run_completed",
            "title": "Type",
            "type": "string"
          },
          "usage": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/Usage"
              },
              {
                "type": "null"
              }
            ],
            "default": null
          }
        },
        "required": [
          "type",
          "messageId",
          "durationMs",
          "usage"
        ],
        "title": "RunCompletedEvent",
        "type": "object"
      },
      "RunFailedEvent": {
        "properties": {
          "code": {
            "title": "Code",
            "type": "string"
          },
          "message": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "const": "run_failed",
            "default": "run_failed",
            "title": "Type",
            "type": "string"
          }
        },
        "required": [
          "type",
          "code",
          "message"
        ],
        "title": "RunFailedEvent",
        "type": "object"
      },
      "RunStartedEvent": {
        "properties": {
          "conversationId": {
            "title": "Conversationid",
            "type": "string"
          },
          "type": {
            "const": "run_started",
            "default": "run_started",
            "title": "Type",
            "type": "string"
          },
          "userMessageId": {
            "title": "Usermessageid",
            "type": "string"
          }
        },
        "required": [
          "type",
          "conversationId",
          "userMessageId"
        ],
        "title": "RunStartedEvent",
        "type": "object"
      },
      "TextDeltaEvent": {
        "properties": {
          "text": {
            "title": "Text",
            "type": "string"
          },
          "type": {
            "const": "text_delta",
            "default": "text_delta",
            "title": "Type",
            "type": "string"
          }
        },
        "required": [
          "type",
          "text"
        ],
        "title": "TextDeltaEvent",
        "type": "object"
      },
      "TextPart": {
        "description": "A stretch of Claude's thinking, answer text, or a progress note (text written just\nbefore a tool call).",
        "properties": {
          "text": {
            "title": "Text",
            "type": "string"
          },
          "type": {
            "enum": [
              "thinking",
              "text",
              "note"
            ],
            "title": "Type",
            "type": "string"
          }
        },
        "required": [
          "type",
          "text"
        ],
        "title": "TextPart",
        "type": "object"
      },
      "ThinkingDeltaEvent": {
        "description": "A piece of Claude's summarized reasoning. It can arrive before the text and again\nbetween pieces of text, around tool calls.",
        "properties": {
          "text": {
            "title": "Text",
            "type": "string"
          },
          "type": {
            "const": "thinking_delta",
            "default": "thinking_delta",
            "title": "Type",
            "type": "string"
          }
        },
        "required": [
          "type",
          "text"
        ],
        "title": "ThinkingDeltaEvent",
        "type": "object"
      },
      "ToolFinishedEvent": {
        "properties": {
          "agent": {
            "title": "Agent",
            "type": "string"
          },
          "durationMs": {
            "title": "Durationms",
            "type": "integer"
          },
          "ok": {
            "title": "Ok",
            "type": "boolean"
          },
          "tool": {
            "title": "Tool",
            "type": "string"
          },
          "type": {
            "const": "tool_finished",
            "default": "tool_finished",
            "title": "Type",
            "type": "string"
          }
        },
        "required": [
          "type",
          "agent",
          "tool",
          "ok",
          "durationMs"
        ],
        "title": "ToolFinishedEvent",
        "type": "object"
      },
      "ToolPart": {
        "description": "A tool Claude called while replying.",
        "properties": {
          "agent": {
            "title": "Agent",
            "type": "string"
          },
          "durationMs": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Durationms"
          },
          "ok": {
            "anyOf": [
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ],
            "title": "Ok"
          },
          "tool": {
            "title": "Tool",
            "type": "string"
          },
          "type": {
            "const": "tool",
            "default": "tool",
            "title": "Type",
            "type": "string"
          }
        },
        "required": [
          "type",
          "agent",
          "tool",
          "ok",
          "durationMs"
        ],
        "title": "ToolPart",
        "type": "object"
      },
      "ToolStartedEvent": {
        "properties": {
          "agent": {
            "title": "Agent",
            "type": "string"
          },
          "tool": {
            "title": "Tool",
            "type": "string"
          },
          "type": {
            "const": "tool_started",
            "default": "tool_started",
            "title": "Type",
            "type": "string"
          }
        },
        "required": [
          "type",
          "agent",
          "tool"
        ],
        "title": "ToolStartedEvent",
        "type": "object"
      },
      "Usage": {
        "description": "Tokens spent on one message, sub-agents included. `input_tokens` excludes cached\ninput, which is counted in the two cache fields.",
        "properties": {
          "cacheReadTokens": {
            "title": "Cachereadtokens",
            "type": "integer"
          },
          "cacheWriteTokens": {
            "title": "Cachewritetokens",
            "type": "integer"
          },
          "inputTokens": {
            "title": "Inputtokens",
            "type": "integer"
          },
          "outputTokens": {
            "title": "Outputtokens",
            "type": "integer"
          }
        },
        "required": [
          "inputTokens",
          "outputTokens",
          "cacheReadTokens",
          "cacheWriteTokens"
        ],
        "title": "Usage",
        "type": "object"
      },
      "UsageUpdatedEvent": {
        "properties": {
          "type": {
            "const": "usage_updated",
            "default": "usage_updated",
            "title": "Type",
            "type": "string"
          },
          "usage": {
            "$ref": "#/components/schemas/Usage"
          }
        },
        "required": [
          "type",
          "usage"
        ],
        "title": "UsageUpdatedEvent",
        "type": "object"
      }
    }
  },
  "info": {
    "title": "Inbox Copilot API",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/v1/auth/google": {
      "post": {
        "description": "Exchange a Google authorization code for an app session cookie.",
        "operationId": "login_with_google",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/GoogleLoginRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CurrentUserRead"
                }
              }
            },
            "description": "Successful Response"
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetail"
                }
              },
              "application/problem+json": {}
            },
            "description": "Bad Request"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetail"
                }
              },
              "application/problem+json": {}
            },
            "description": "Unauthorized"
          },
          "403": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetail"
                }
              },
              "application/problem+json": {}
            },
            "description": "Forbidden"
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetail"
                }
              },
              "application/problem+json": {}
            },
            "description": "Not Found"
          },
          "409": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetail"
                }
              },
              "application/problem+json": {}
            },
            "description": "Conflict"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetail"
                }
              },
              "application/problem+json": {}
            },
            "description": "Unprocessable Entity"
          },
          "500": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetail"
                }
              },
              "application/problem+json": {}
            },
            "description": "Internal Server Error"
          },
          "502": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetail"
                }
              },
              "application/problem+json": {}
            },
            "description": "Bad Gateway"
          }
        },
        "summary": "Login With Google",
        "tags": [
          "auth"
        ]
      }
    },
    "/api/v1/auth/logout": {
      "post": {
        "operationId": "logout",
        "parameters": [
          {
            "description": "Also revoke Google access",
            "in": "query",
            "name": "revoke",
            "required": false,
            "schema": {
              "default": false,
              "description": "Also revoke Google access",
              "title": "Revoke",
              "type": "boolean"
            }
          },
          {
            "in": "cookie",
            "name": "inbox_copilot_session",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Inbox Copilot Session"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Successful Response"
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetail"
                }
              },
              "application/problem+json": {}
            },
            "description": "Bad Request"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetail"
                }
              },
              "application/problem+json": {}
            },
            "description": "Unauthorized"
          },
          "403": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetail"
                }
              },
              "application/problem+json": {}
            },
            "description": "Forbidden"
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetail"
                }
              },
              "application/problem+json": {}
            },
            "description": "Not Found"
          },
          "409": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetail"
                }
              },
              "application/problem+json": {}
            },
            "description": "Conflict"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetail"
                }
              },
              "application/problem+json": {}
            },
            "description": "Unprocessable Entity"
          },
          "500": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetail"
                }
              },
              "application/problem+json": {}
            },
            "description": "Internal Server Error"
          },
          "502": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetail"
                }
              },
              "application/problem+json": {}
            },
            "description": "Bad Gateway"
          }
        },
        "summary": "Logout",
        "tags": [
          "auth"
        ]
      }
    },
    "/api/v1/auth/me": {
      "get": {
        "operationId": "read_current_user",
        "parameters": [
          {
            "in": "cookie",
            "name": "inbox_copilot_session",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Inbox Copilot Session"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CurrentUserRead"
                }
              }
            },
            "description": "Successful Response"
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetail"
                }
              },
              "application/problem+json": {}
            },
            "description": "Bad Request"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetail"
                }
              },
              "application/problem+json": {}
            },
            "description": "Unauthorized"
          },
          "403": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetail"
                }
              },
              "application/problem+json": {}
            },
            "description": "Forbidden"
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetail"
                }
              },
              "application/problem+json": {}
            },
            "description": "Not Found"
          },
          "409": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetail"
                }
              },
              "application/problem+json": {}
            },
            "description": "Conflict"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetail"
                }
              },
              "application/problem+json": {}
            },
            "description": "Unprocessable Entity"
          },
          "500": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetail"
                }
