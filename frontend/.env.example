# Copy to frontend/.env. Only VITE_* variables reach the browser bundle, and they are public.

# Same OAuth client ID as the backend's GOOGLE_CLIENT_ID
VITE_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# Leave unset in development: the Vite proxy serves /api from the same origin.
# Set it only when the API lives on a different origin (and add that origin to CORS_ORIGINS).
# VITE_API_BASE_URL=https://api.example.com
