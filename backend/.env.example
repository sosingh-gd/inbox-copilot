# Copy to backend/.env for local development. Never commit the real .env.

# Google OAuth client (type "Web application"), see README.md
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Fernet key used to encrypt Google refresh tokens at rest (command in README.md)
TOKEN_ENCRYPTION_KEY=generate-with-the-command-in-README

# Claude API key for the chat feature
ANTHROPIC_API_KEY=your-anthropic-api-key

DATABASE_URL=sqlite:///./app.db
SESSION_TTL_DAYS=7
COOKIE_SECURE=false
LOG_LEVEL=INFO

# Weather (Open-Meteo needs no API key). Units: metric or imperial.
WEATHER_HOME_LOCATION=Berlin
WEATHER_TIMEZONE=Europe/Berlin
WEATHER_UNITS=metric

# Only needed if the frontend is served from a different origin than the API.
# In development the Vite proxy makes everything same-origin, so leave this unset.
# CORS_ORIGINS=["http://localhost:5173"]
